<?xml version="1.0" encoding="utf-8"?>
<!-- 分段控件单个选项背景（每行应用数量的 4/5/6/7）。
     focused = 白框提亮（遥控器指到哪个就亮哪个）
     selected = 绿色填充 + 绿描边（当前生效值）
     默认 = 比行背景更亮一点的灰，让数字浮起来 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2F6B45" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3DFFFFFF" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2F6B45" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#FF5FA978" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF262C35" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>