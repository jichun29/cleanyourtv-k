<?xml version="1.0" encoding="utf-8"?>
<!-- 设置行通用背景（K 2026-10-22 桌面设置页重做）。
     三种状态分离：
       focused = 白色外框 + 提亮，遥控器焦点走哪都看得清（最重要的状态）
       selected = 深灰 + 淡绿左描边，表示「当前值」，不抢焦点的戏
       默认 = 深灰圆角
     之前 settings_choice_bg 的 selected 用绿色填充，跟 focused 撞色，分不出主次。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2A3038" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FF5FA978" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2EFFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2A3038" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#884DAE6D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1C2128" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>