<?xml version="1.0" encoding="utf-8"?>
<!-- 检查更新页 v2.2：修复布局显示问题。
     不用 wrap_content，改用固定高度确保 horizontal LinearLayout 正确分配空间。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="48dp">

    <LinearLayout
        android:layout_width="720dp"
        android:layout_height="480dp"
        android:background="@drawable/cc_panel_bg"
        android:orientation="horizontal"
        android:padding="36dp">

        <!-- 左侧：版本信息 + 状态 + 操作 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="检查更新"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/updateStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="正在检查更新…"
                android:textColor="#BFFFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/updateVersions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#99FFFFFF"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/updateProgress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="24dp" />

            <LinearLayout
                android:id="@+id/updateActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/updateDownload"
                    style="@style/TopButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="下载更新" />

                <Button
                    android:id="@+id/updateSkip"
                    style="@style/TopButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="跳过此版" />
            </LinearLayout>

            <Button
                android:id="@+id/updateClose"
                style="@style/TopButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="关闭" />
        </LinearLayout>

        <!-- 右侧：更新日志 -->
        <LinearLayout
            android:id="@+id/updateLogPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:layout_marginStart="32dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/updateLogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="更新日志"
                android:textColor="#E6FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/updateNotes"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp"
                android:background="@drawable/cc_tile_glass"
                android:gravity="top"
                android:lineSpacingMultiplier="1.4"
                android:padding="16dp"
                android:scrollbars="vertical"
                android:textColor="#D9FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>