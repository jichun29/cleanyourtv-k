<?xml version="1.0" encoding="utf-8"?>
<!-- 检查更新页 v4（K 2026-10-22 第三轮）：收紧比例、去掉失衡。
     修掉：1) 底部按钮过大像白板 → 改成右对齐常规宽度 2) 右侧日志框大而空 → 高度随内容、
     上限 300dp 3) 左栏空旷 → 版本号做成胶囊标签 4) 卡片收窄到 760dp -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="40dp">

    <LinearLayout
        android:layout_width="760dp"
        android:layout_height="wrap_content"
        android:background="@drawable/cc_panel_bg"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- 标题行：整体只出现一次，不再左右各一个 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="检查更新"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- 状态行：状态 + 版本胶囊，横向一行，省掉大片纵向空白 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/updateStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="正在检查更新…"
                android:textColor="#BFFFFFFF"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/updateProgress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="12dp" />

            <TextView
                android:id="@+id/updateVersions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="@drawable/cc_tile_glass"
                android:paddingLeft="12dp"
                android:paddingTop="5dp"
                android:paddingRight="12dp"
                android:paddingBottom="5dp"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 更新日志：高度随内容，最多 300dp（内容少时不留空洞） -->
        <TextView
            android:id="@+id/updateLogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="更新日志"
            android:textColor="#E6FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/updateNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/cc_tile_glass"
            android:gravity="top|start"
            android:lineSpacingExtra="8dp"
            android:maxHeight="300dp"
            android:minHeight="0dp"
            android:padding="20dp"
            android:scrollbars="vertical"
            android:textColor="#F0FFFFFF"
            android:textSize="16sp" />

        <!-- 底部按钮行：右对齐，下载/跳过/关闭三个等宽，不再用巨型通栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/updateDownload"
                style="@style/TopButton"
                android:layout_width="160dp"
                android:layout_height="46dp"
                android:text="下载并安装"
                android:visibility="gone" />

            <Button
                android:id="@+id/updateSkip"
                style="@style/TopButton"
                android:layout_width="140dp"
                android:layout_height="46dp"
                android:layout_marginStart="12dp"
                android:text="跳过此版"
                android:visibility="gone" />

            <Button
                android:id="@+id/updateClose"
                style="@style/TopButton"
                android:layout_width="140dp"
                android:layout_height="46dp"
                android:layout_marginStart="12dp"
                android:text="关闭" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>