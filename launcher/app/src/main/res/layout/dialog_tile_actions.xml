<?xml version="1.0" encoding="utf-8"?>
<!-- Tile actions dialog: glass panel style matching the launcher (tvOS-like frosted).
     Shown on long-press OK or MENU key on an app tile. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="22dp"
    android:paddingBottom="20dp"
    android:elevation="12dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500"
        android:letterSpacing="-0.01" />

    <TextView
        android:id="@+id/pkg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        android:ellipsize="middle"
        android:textColor="#80FFFFFF"
        android:textSize="12sp"
        android:letterSpacing="0.03"
        android:fontFamily="@font/outfit" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/btnOpen"
            style="@style/TopButton"
            android:layout_width="match_parent"
            android:layout_marginStart="0dp"
            android:layout_marginBottom="10dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/action_open"
            android:gravity="center_vertical"
            android:nextFocusUp="@+id/btnOpen"
            android:nextFocusDown="@+id/btnDetails"
            android:nextFocusLeft="@+id/btnOpen"
            android:nextFocusRight="@+id/btnOpen" />

        <TextView
            android:id="@+id/btnDetails"
            style="@style/TopButton"
            android:layout_width="match_parent"
            android:layout_marginStart="0dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/action_details"
            android:gravity="center_vertical"
            android:nextFocusUp="@+id/btnOpen"
            android:nextFocusDown="@+id/btnDetails"
            android:nextFocusLeft="@+id/btnDetails"
            android:nextFocusRight="@+id/btnDetails" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/action_hint"
        android:textColor="#66FFFFFF"
        android:textSize="12sp"
        android:fontFamily="@font/outfit" />
</LinearLayout>
