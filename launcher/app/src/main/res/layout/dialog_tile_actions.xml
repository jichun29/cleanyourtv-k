<?xml version="1.0" encoding="utf-8"?>
<!-- Tile actions dialog: glass panel style matching the launcher (tvOS-like frosted).
     Shown on MENU key on an app tile. K 定制 v3.1: 打开/置顶到最前/移动位置/管理·卸载/应用信息 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="22dp"
    android:paddingBottom="20dp"
    android:elevation="12dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500"
        android:letterSpacing="-0.01" />

    <TextView
        android:id="@+id/pkg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        android:ellipsize="middle"
        android:textColor="#80FFFFFF"
        android:textSize="12sp"
        android:letterSpacing="0.03"
        android:fontFamily="@font/outfit" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/btnOpen"
            style="@style/TopButton"
            android:layout_width="match_parent"
            android:layout_marginStart="0dp"
            android:layout_marginBottom="10dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/action_open"
            android:gravity="center_vertical"
            android:nextFocusUp="@+id/btnHide"
            android:nextFocusDown="@+id/btnTop" />

        <TextView
            android:id="@+id/btnTop"
            style="@style/TopButton"
            android:layout_width="match_parent"
            android:layout_marginStart="0dp"
            android:layout_marginBottom="10dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/action_top"
            android:gravity="center_vertical"
            android:nextFocusUp="@+id/btnOpen"
            android:nextFocusDown="@+id/btnMove" />

        <TextView
            android:id="@+id/btnMove"
            style="@style/TopButton"
            android:layout_width="match_parent"
            android:layout_marginStart="0dp"
            android:layout_marginBottom="10dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/action_move"
            android:gravity="center_vertical"
            android:nextFocusUp="@+id/btnTop"
            android:nextFocusDown="@+id/btnDetails" />

        <TextView
            android:id="@+id/btnDetails"
            style="@style/TopButton"
            android:layout_width="match_parent"
            android:layout_marginStart="0dp"
            android:layout_marginBottom="10dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/action_details"
            android:gravity="center_vertical"
            android:nextFocusUp="@+id/btnMove"
            android:nextFocusDown="@+id/btnInfo" />

        <TextView
            android:id="@+id/btnInfo"
            style="@style/TopButton"
            android:layout_width="match_parent"
            android:layout_marginStart="0dp"
            android:layout_marginBottom="10dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/action_info"
            android:gravity="center_vertical"
            android:nextFocusUp="@+id/btnDetails"
            android:nextFocusDown="@+id/btnHide" />

        <TextView
            android:id="@+id/btnHide"
            style="@style/TopButton"
            android:layout_width="match_parent"
            android:layout_marginStart="0dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/action_hide"
            android:gravity="center_vertical"
            android:nextFocusUp="@+id/btnInfo"
            android:nextFocusDown="@+id/btnOpen" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/action_hint"
        android:textColor="#66FFFFFF"
        android:textSize="12sp"
        android:fontFamily="@font/outfit" />
</LinearLayout>
