<?xml version="1.0" encoding="utf-8"?>
<!-- 快传页（2026-10-23 K）：大字显示电视地址 + 二维码（方法二扫码即开），手机推 APK 过来装。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="40dp">

    <LinearLayout
        android:layout_width="680dp"
        android:layout_height="wrap_content"
        android:background="@drawable/cc_panel_bg"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="快传"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="手机或电脑连同一个 Wi-Fi，浏览器打开下面的地址，选 APK 就能推上来装"
            android:textColor="#99FFFFFF"
            android:textSize="15sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="…"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <ImageView
            android:id="@+id/qr"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="24dp"
            android:contentDescription="二维码" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="手机相机扫码即开"
            android:textColor="#66FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="等待手机传文件…"
            android:textColor="#66FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="退出本页服务即停，不常驻后台"
            android:textColor="#44FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
