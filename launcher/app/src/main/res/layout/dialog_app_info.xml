<?xml version="1.0" encoding="utf-8"?>
<!-- App info dialog: glass panel style matching the launcher (tvOS-like frosted). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingTop="26dp"
    android:paddingBottom="24dp"
    android:elevation="12dp">

    <!-- Header: app icon + name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <ImageView
            android:id="@+id/appIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="16dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/appName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:letterSpacing="-0.01" />

            <TextView
                android:id="@+id/appPkg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:ellipsize="middle"
                android:textColor="#80FFFFFF"
                android:textSize="13sp"
                android:letterSpacing="0.02"
                android:fontFamily="@font/outfit" />
        </LinearLayout>
    </LinearLayout>

    <!-- Info rows -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Version -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="版本"
                android:textColor="#99FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/outfit" />

            <TextView
                android:id="@+id/infoVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF" />

        <!-- Install time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="安装时间"
                android:textColor="#99FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/outfit" />

            <TextView
                android:id="@+id/infoInstallTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/outfit" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF" />

        <!-- Update time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="更新时间"
                android:textColor="#99FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/outfit" />

            <TextView
                android:id="@+id/infoUpdateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/outfit" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF" />

        <!-- Target SDK -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="目标 SDK"
                android:textColor="#99FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/outfit" />

            <TextView
                android:id="@+id/infoTargetSdk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/outfit" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF" />

        <!-- Data dir -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="数据目录"
                android:textColor="#99FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/outfit" />

            <TextView
                android:id="@+id/infoDataDir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="280dp"
                android:singleLine="true"
                android:ellipsize="middle"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:fontFamily="@font/outfit" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hint -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="返回键关闭"
        android:textColor="#66FFFFFF"
        android:textSize="12sp"
        android:gravity="center"
        android:fontFamily="@font/outfit" />
</LinearLayout>
