<?xml version="1.0" encoding="utf-8"?>
<!-- 控制中心（K 2026-10-22 v2）：澎湃 OS 4 柔光玻璃 + iOS 控制中心骨架。
     右上角弹出的圆角玻璃面板，内容只有六枚彩色玻璃磁贴。
     不放音量/亮度：遥控器本身有音量键，亮度交给电视画质设置（K 2026-10-22 拍板）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="86dp"
        android:layout_marginEnd="52dp"
        android:orientation="vertical"
        android:background="@drawable/cc_panel_bg"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:elevation="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cc_title"
                android:textColor="#F5FFFFFF"
                android:textSize="19sp"
                android:fontFamily="@font/outfit_medium"
                android:letterSpacing="0.01" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/tiles1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="2dp" />

        <LinearLayout
            android:id="@+id/tiles2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="2dp"
            android:paddingBottom="4dp" />
    </LinearLayout>
</FrameLayout>
