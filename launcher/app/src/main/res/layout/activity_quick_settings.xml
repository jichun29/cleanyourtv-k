<?xml version="1.0" encoding="utf-8"?>
<!-- 控制中心（K 2026-10-22 重做）：iOS 状态栏式。
     上方是圆角方形图标磁贴（信号源 / 网络 / 桌面设置 / 壁纸 / 应用库 / 重排），
     下方是音量滑块。玻璃面板，圆角 28dp，跟 iOS 控制中心一个气质。
     右上角那几个胶囊的功能全搬进来，桌面可以更干净。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="86dp"
        android:layout_marginEnd="52dp"
        android:orientation="vertical"
        android:background="@drawable/cc_panel_bg"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp"
        android:elevation="16dp">

        <!-- 标题行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cc_title"
                android:textColor="#F5FFFFFF"
                android:textSize="19sp"
                android:fontFamily="@font/outfit_medium"
                android:letterSpacing="0.01" />

            <TextView
                android:id="@+id/ccClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8AFFFFFF"
                android:textSize="13sp"
                android:fontFamily="@font/outfit" />
        </LinearLayout>

        <!-- 图标磁贴网格：两行三列 -->
        <LinearLayout
            android:id="@+id/tiles1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/tiles2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp" />

        <!-- 音量 -->
        <LinearLayout
            android:id="@+id/volumeRow"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/cc_slider_bg"
            android:focusable="true"
            android:clickable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/volIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_volume"
                    android:tint="#E6FFFFFF"
                    android:duplicateParentState="true"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/cc_volume"
                    android:textColor="#E6FFFFFF"
                    android:duplicateParentState="true"
                    android:textSize="14sp"
                    android:fontFamily="@font/outfit_medium" />

                <TextView
                    android:id="@+id/volValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#99FFFFFF"
                    android:duplicateParentState="true"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/volBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:progressDrawable="@drawable/cc_slider_track"
                android:max="100"
                android:progress="50"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingTop="12dp"
            android:text="@string/cc_hint"
            android:textColor="#59FFFFFF"
            android:textSize="11sp"
            android:fontFamily="@font/outfit" />
    </LinearLayout>
</FrameLayout>
